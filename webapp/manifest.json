{
  "_version": "1.84.0",
  "sap.app": {
    "id": "zew.newscan.zewnewscan",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.23.0",
      "toolsId": "423504bc-a60a-4a4d-ba87-b56b9a47dfba"
    },

    "dataSources": {
      "ZSCAN_SERVICE": {
        "uri": "/sap/opu/odata/sap/ZODATA_WM_EMPAQUE_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      },
      "ZTABLE_SERVICE": {
        "uri": "/sap/opu/odata/sap/ZODATA_WM_EMPAQUE_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      },

      "ZHU_SERVICE": {
        "uri": "/sap/opu/odata/sap/ZODATA_WM_EMPAQUE_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      },

      "ZPRINT_SERVICE": {
        "uri": "/sap/opu/odata/sap/ZODATA_WM_EMPAQUE_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },

  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },

  "sap.ui5": {
    "flexEnabled": true,

    "dependencies": {
      "minUI5Version": "1.147.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ndc": {}
      }
    },

    "contentDensities": {
      "compact": true,
      "cozy": true
    },

    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zew.newscan.zewnewscan.i18n.i18n"
        }
      },

      "": {
         "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "ZSCAN_SERVICE",
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },

      "tableModel": {
         "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "ZTABLE_SERVICE"
      },

      "huModel": {
         "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "ZHU_SERVICE"
      },

      "printModel": {
         "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "ZPRINT_SERVICE"
      }
    },

    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "zew.newscan.zewnewscan.view",
        "async": true,
        "viewPath": "zew.newscan.zewnewscan.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        }
      }
    },

    "rootView": {
      "viewName": "zew.newscan.zewnewscan.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}